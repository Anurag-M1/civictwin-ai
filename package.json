{
  "name": "civictwin-ai",
  "version": "1.0.0",
  "description": "CivicTwin AI - From citizen signals to infrastructure decisions. Digital Public Infrastructure & Governance intelligence platform.",
  "type": "module",
  "main": "dist/server/index.js",
  "scripts": {
    "dev:server": "tsx watch src/server/index.ts",
    "dev:client": "vite",
    "dev": "concurrently -n \"API,WEB\" -c \"blue,green\" \"npm run dev:server\" \"npm run dev:client\"",
    "build:server": "tsc -p tsconfig.server.json",
    "build:client": "vite build",
    "build": "npm run prisma:generate && npm run build:server && npm run build:client",
    "start": "node dist/server/index.js",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:seed": "tsx prisma/seed.ts",
    "test": "vitest run",
    "test:unit": "vitest run tests/schema.test.ts tests/priority_and_simulation.test.ts tests/evidence_graph.test.ts tests/ai_intelligence_layer.test.ts",
    "test:integration": "vitest run tests/api.test.ts tests/auth.test.ts tests/audit.test.ts tests/analytics.test.ts tests/error.test.ts tests/ingestion.test.ts tests/radar_and_analytics.test.ts tests/dashboard_and_modules.test.ts tests/gemini_evidence_brief.test.ts tests/briefs_and_simulation.test.ts tests/multilingual_and_voice.test.ts",
    "test:e2e": "vitest run tests/golden_demo_flow.test.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "lint": "eslint src/"
  },
  "keywords": [
    "digital-public-infrastructure",
    "civic-tech",
    "gemini",
    "ai-governance",
    "gis",
    "smart-cities"
  ],
  "author": "CivicTwin AI Team",
  "license": "Apache-2.0",
  "dependencies": {
    "@google/genai": "^2.24.0",
    "@google/generative-ai": "^0.24.1",
    "@prisma/client": "^6.4.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.475.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-leaflet": "^4.2.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/leaflet": "^1.9.16",
    "@types/node": "^22.13.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/supertest": "^6.0.2",
    "@vercel/node": "^16.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "eslint": "^10.11.0",
    "playwright": "^1.63.0",
    "prisma": "^6.4.1",
    "supertest": "^7.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^6.2.0",
    "vitest": "^3.0.6"
  }
}
