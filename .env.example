# ==============================================================================
# CivicTwin AI — Environment Configuration Reference
# Digital Public Infrastructure & Governance Intelligence Platform
# ==============================================================================

# 1. Runtime Environment
# Values: 'development' | 'production' | 'test'
NODE_ENV=production

# 2. Server Port
# TCP port for backend Express API server and static client bundle serving
PORT=3001

# 3. Client API URL (used by Vite frontend during dev/build)
VITE_API_URL=http://localhost:3001/api/v1

# 4. Database Connection URL
# SQLite (Zero-config default for demonstrations & lightweight deployments):
DATABASE_URL="file:./dev.db"
# PostgreSQL (Production cluster recommendation):
# DATABASE_URL="postgresql://civic_admin:SecurePassword123@db-host:5432/civictwin_db?schema=public&sslmode=prefer"

# 5. Google AI Studio (Gemini) API Key
# Optional for evaluation: when omitted or invalid, the platform automatically activates
# the deterministic public-sector NLP fallback engine with verified schema conformity.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.0-flash"

# 6. System Security & Access Controls
# Cryptographic salt for session signing and internal HMAC derivation (minimum 32 characters)
SESSION_SECRET="civictwin-production-cryptographic-salt-change-in-production-987123"

# 7. CORS Whitelist
# Comma-separated list of allowed origins. In production, requests from unlisted origins are blocked.
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:3001,https://civictwin.gov.in"

# 8. Rate Limiting (Token-Bucket)
# Maximum requests per client IP per window
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_MS=60000
